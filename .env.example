# Generate private local values with node scripts/init-resourceos.mjs.
POSTGRES_PASSWORD=
DATABASE_URL=postgresql://resourceos:REPLACE_LOCAL_PASSWORD@127.0.0.1:5432/resourceos
DRT_SECRET=
DEMO_PASSWORD=
APP_URL=http://localhost:3000
# HTTPS is required when exposing this application remotely.
# Never use demonstration accounts for real production records.

# Hosted deployment only: persistent evidence and simulator journal directory.
# RESOURCEOS_DATA_DIR=/var/data/resourceos
# Render supplies RENDER_EXTERNAL_URL automatically; APP_URL can override it for a custom HTTPS domain.
# ALLOW_DEMO_SEED=true
